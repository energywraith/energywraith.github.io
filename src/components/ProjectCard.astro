---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

type Props = CollectionEntry<"works">;

const { data } = Astro.props;
const { title, description, link, splashImage, tags, showAsPost } = data;

const href = link;
const target = showAsPost ? "_self" : "_blank";
const tagList = tags.map((tag) => tag.toLowerCase()).join(",");
---

<article
  class="group relative flex h-full flex-1 basis-[280px] flex-col overflow-hidden rounded-2xl border border-white/60 bg-white/50 shadow-lg shadow-cyan-950/5 backdrop-blur-md transition-all hover:-translate-y-1 hover:border-cyan-500/40 hover:shadow-xl hover:shadow-cyan-500/20 md:basis-[32%]"
  data-tags={tagList}
>
  <a class="relative block w-full overflow-hidden" href={href} target={target} rel="noreferrer">
    <Image
      src={splashImage}
      class="h-[180px] w-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
      alt={`${title} Splash Image`}
      width="308"
      height="180"
    />
    {
      !showAsPost && (
        <span
          class="absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-full bg-white/80 text-cyan-700 shadow-sm backdrop-blur-sm"
          title="Otwiera się w nowej karcie"
        >
          <Icon name="external-link" class="h-3 w-3" />
        </span>
      )
    }
  </a>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <a href={href} target={target} rel="noreferrer">
      <h4
        class="font-pattaya text-lg text-cyan-700 transition-all group-hover:text-cyan-600"
      >
        {title}
      </h4>
    </a>

    <ul class="flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <li class="rounded-full border border-cyan-500/25 bg-cyan-500/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-cyan-700">
            #{tag}
          </li>
        ))
      }
    </ul>

    <p class="text-sm text-slate-600">
      {description}
    </p>
  </div>
</article>
