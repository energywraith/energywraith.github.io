---
const STREAM_URL = "https://radio.vanture.club/listen/vanture/radio.mp3";
---

<div
  id="radio-player"
  class="mx-auto flex w-fit max-w-full items-center gap-2.5 rounded-full border border-cyan-500/40 bg-cyan-500/10 px-3.5 py-1.5 text-xs text-cyan-950 shadow-[0_8px_20px_-10px_rgba(6,182,212,0.45)] backdrop-blur-md transition-shadow duration-500"
>
  <a
    href="https://vanture.club"
    target="_blank"
    rel="noopener noreferrer"
    class="shrink-0 opacity-90 transition-opacity hover:opacity-100"
  >
    <img
      src="/vanture.png"
      alt="Vanture"
      class="h-5 w-auto [filter:brightness(0.62)_saturate(1.35)]"
    />
  </a>

  <button
    id="radio-toggle"
    type="button"
    aria-label="Play Vanture Radio"
    aria-pressed="false"
    class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-cyan-500/20 text-cyan-700 transition-colors hover:bg-cyan-500/30"
  >
    <svg
      id="radio-icon-play"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="h-3 w-3 translate-x-[1px]"
    >
      <path d="M8 5v14l11-7z"></path>
    </svg>
    <svg
      id="radio-icon-pause"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="hidden h-3 w-3"
    >
      <path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
    </svg>
    <svg
      id="radio-icon-loading"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      class="hidden h-3 w-3 animate-spin text-cyan-700"
    >
      <circle
        cx="12"
        cy="12"
        r="9"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="40 100"></circle>
    </svg>
  </button>

  <span
    class="h-4 w-px shrink-0 rounded-full bg-cyan-500/30"
    aria-hidden="true"
  ></span>

  <span id="radio-volume-wrap" class="group/vol flex shrink-0 items-center">
    <button
      id="radio-volume-toggle"
      type="button"
      aria-label="Toggle volume slider"
      aria-expanded="false"
      class="-m-1.5 flex shrink-0 items-center justify-center rounded-full p-1.5 text-cyan-700"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="h-3.5 w-3.5 shrink-0"
        aria-hidden="true"
      >
        <path
          d="M3 10v4h4l5 5V5L7 10H3zm13.5 2A4.5 4.5 0 0 0 14.5 8v8a4.5 4.5 0 0 0 2-6z"
        ></path>
      </svg>
    </button>

    <input
      id="radio-volume"
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="Volume"
      style="--radio-volume: 50%"
      class="radio-volume-input box-content -my-1.5 -mx-1.5 h-1.5 w-0 shrink-0 cursor-pointer appearance-none overflow-hidden rounded-full bg-[linear-gradient(to_right,theme(colors.cyan.600)_var(--radio-volume),theme(colors.cyan.950/15)_var(--radio-volume))] bg-clip-content px-1.5 py-1.5 opacity-0 transition-all duration-200 group-hover/vol:ml-1.5 group-hover/vol:w-16 group-hover/vol:opacity-100 group-focus-within/vol:ml-1.5 group-focus-within/vol:w-16 group-focus-within/vol:opacity-100 [&::-moz-range-thumb]:h-2.5 [&::-moz-range-thumb]:w-2.5 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-cyan-700 [&::-moz-range-thumb]:shadow-sm [&::-webkit-slider-thumb]:h-2.5 [&::-webkit-slider-thumb]:w-2.5 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-cyan-700 [&::-webkit-slider-thumb]:shadow-sm"
    />
  </span>

  <audio id="radio-audio" preload="none" class="hidden">
    <source src={STREAM_URL} type="audio/mpeg" />
  </audio>
</div>

<style>
  #radio-player.is-playing {
    animation: radio-glow 2.4s ease-in-out infinite;
  }

  @keyframes radio-glow {
    0%,
    100% {
      box-shadow: 0 8px 20px -10px rgba(6, 182, 212, 0.45);
    }
    50% {
      box-shadow:
        0 8px 26px -8px rgba(6, 182, 212, 0.75),
        0 0 18px 1px rgba(34, 211, 238, 0.45);
    }
  }

  /* tap-to-toggle for touch devices, where :hover/:focus-within don't reveal the slider */
  #radio-volume-wrap.is-expanded .radio-volume-input {
    margin-left: 0.375rem;
    width: 4rem;
    opacity: 1;
  }
</style>

<script>
  const player = document.getElementById("radio-player")!;
  const button = document.getElementById("radio-toggle") as HTMLButtonElement;
  const playIcon = document.getElementById("radio-icon-play")!;
  const pauseIcon = document.getElementById("radio-icon-pause")!;
  const loadingIcon = document.getElementById("radio-icon-loading")!;
  const volumeSlider = document.getElementById(
    "radio-volume"
  ) as HTMLInputElement;
  const volumeWrap = document.getElementById("radio-volume-wrap")!;
  const volumeToggle = document.getElementById(
    "radio-volume-toggle"
  ) as HTMLButtonElement;

  // Clicking the slider focuses it, and group-focus-within keeps it expanded
  // until focus is lost — mouseleave alone doesn't do that, so blur it
  // explicitly once the pointer leaves so it collapses right away.
  volumeWrap.addEventListener("mouseleave", () => {
    if (document.activeElement === volumeSlider) volumeSlider.blur();
  });

  // :hover/:focus-within don't reveal anything on touch, so the icon also
  // works as an explicit tap-to-toggle for the slider.
  volumeToggle.addEventListener("click", () => {
    const expanded = volumeWrap.classList.toggle("is-expanded");
    volumeToggle.setAttribute("aria-expanded", String(expanded));
  });
  document.addEventListener("click", (e) => {
    if (!volumeWrap.contains(e.target as Node)) {
      volumeWrap.classList.remove("is-expanded");
      volumeToggle.setAttribute("aria-expanded", "false");
    }
  });

  let audio = document.getElementById("radio-audio") as HTMLAudioElement;
  const streamSrc = audio.querySelector("source")?.src ?? "";

  function applyVolume() {
    audio.volume = Number(volumeSlider.value) / 100;
    volumeSlider.style.setProperty("--radio-volume", `${volumeSlider.value}%`);
  }
  applyVolume();
  volumeSlider.addEventListener("input", applyVolume);

  type PlayerState = "idle" | "loading" | "playing";

  function setState(state: PlayerState) {
    playIcon.classList.toggle("hidden", state !== "idle");
    loadingIcon.classList.toggle("hidden", state !== "loading");
    pauseIcon.classList.toggle("hidden", state !== "playing");
    player.classList.toggle("is-playing", state === "playing");
    button.setAttribute(
      "aria-pressed",
      state === "playing" ? "true" : "false"
    );
    button.setAttribute(
      "aria-label",
      state === "playing" ? "Stop Vanture Radio" : "Play Vanture Radio"
    );
  }

  function bindAudioEvents(el: HTMLAudioElement) {
    el.addEventListener("waiting", () => setState("loading"));
    el.addEventListener("playing", () => setState("playing"));
    el.addEventListener("pause", () => setState("idle"));
    el.addEventListener("error", () => setState("idle"));
  }
  bindAudioEvents(audio);

  // Swapping the audio output device mid-stream (e.g. Bluetooth headphones
  // reconnecting) can leave the browser's decode pipeline bound to the old
  // route: playback keeps glitching until the page is reloaded. pause()+load()
  // isn't enough to clear that, so replace the element outright to force a
  // fresh output stream against the current device.
  let recreateTimer: ReturnType<typeof setTimeout> | undefined;
  function recreateAudio() {
    const wasPlaying = !audio.paused;
    const fresh = document.createElement("audio");
    fresh.id = "radio-audio";
    fresh.preload = "none";
    fresh.className = "hidden";
    const source = document.createElement("source");
    source.src = streamSrc;
    source.type = "audio/mpeg";
    fresh.appendChild(source);

    audio.replaceWith(fresh);
    audio = fresh;
    bindAudioEvents(audio);
    applyVolume();

    if (wasPlaying) {
      setState("loading");
      audio.play().catch(() => setState("idle"));
    }
  }

  if (navigator.mediaDevices?.addEventListener) {
    navigator.mediaDevices.addEventListener("devicechange", () => {
      clearTimeout(recreateTimer);
      recreateTimer = setTimeout(() => {
        if (!audio.paused) recreateAudio();
      }, 300);
    });
  }

  // Fallback net for everything else that can leave playback silently broken
  // (background-tab throttling, a stop/replay race, network hiccups): compare
  // real elapsed time against how far currentTime actually moved. Two
  // consecutive misses (~8s of drift/stall) triggers the same hard reset.
  const WATCHDOG_INTERVAL_MS = 4000;
  const DRIFT_TOLERANCE_MS = 1500;
  const MAX_MISSES = 2;
  let watchdogMisses = 0;
  let lastWallTime = 0;
  let lastAudioTime = 0;

  function watchdogTick() {
    if (audio.paused) {
      watchdogMisses = 0;
      lastWallTime = 0;
      return;
    }
    const now = performance.now();
    if (lastWallTime === 0) {
      lastWallTime = now;
      lastAudioTime = audio.currentTime;
      return;
    }
    const wallDeltaMs = now - lastWallTime;
    const audioDeltaMs = (audio.currentTime - lastAudioTime) * 1000;
    lastWallTime = now;
    lastAudioTime = audio.currentTime;

    if (audioDeltaMs < wallDeltaMs - DRIFT_TOLERANCE_MS) {
      watchdogMisses++;
      if (watchdogMisses >= MAX_MISSES) {
        watchdogMisses = 0;
        recreateAudio();
      }
    } else {
      watchdogMisses = 0;
    }
  }
  setInterval(watchdogTick, WATCHDOG_INTERVAL_MS);

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") watchdogTick();
  });
  window.addEventListener("focus", watchdogTick);

  let busy = false;
  button.addEventListener("click", () => {
    if (busy) return;
    busy = true;
    if (audio.paused) {
      setState("loading");
      audio
        .play()
        .catch(() => setState("idle"))
        .finally(() => {
          busy = false;
        });
    } else {
      audio.pause();
      // drop the buffered stream so resuming later starts fresh at "live", not stuck catching up
      audio.load();
      setState("idle");
      busy = false;
    }
  });
</script>
