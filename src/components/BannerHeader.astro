<h1
  class="relative w-full font-pattaya text-4xl tracking-wider sm:text-5xl md:text-6xl lg:text-7xl"
  aria-label="Hey, I am Adam!"
>
  <span class="invisible" aria-hidden="true"
    >Hey, I am <strong class="text-cyan-600">Ad</strong><strong
      class="text-cyan-600">am!</strong
    ></span
  >
  <span id="banner-header" class="absolute inset-0" aria-hidden="true"></span>
</h1>

<script>
  import Typewriter from "typewriter-effect/dist/core";
  import type { TypewriterFunctionState } from "@/utils/types/typewriter";

  function runTypewriter() {
    const bannerHeader = document.getElementById("banner-header");
    if (!bannerHeader) return;

    bannerHeader.innerHTML = "";

    const typewriter = new Typewriter(bannerHeader, {
      delay: 75,
    });

    typewriter
      .pauseFor(500)
      .typeString("Hey, I am ")
      .pauseFor(300)
      .typeString("<strong class='text-cyan-600'>Adbd</strong>")
      .deleteChars(2)
      .typeString("<strong class='text-cyan-600'>am!</strong>")
      .pauseFor(850)
      .callFunction(function (state: TypewriterFunctionState) {
        state.elements.cursor.style.display = "none";
      })
      .start();
  }

  document.addEventListener("astro:page-load", runTypewriter);
</script>
