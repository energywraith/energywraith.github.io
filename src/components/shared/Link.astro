---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { buttonVariants } from "@/utils/linkVariants";
import type { ButtonVariant } from "@/utils/linkVariants";

type Props = HTMLAttributes<"a"> & {
  icon?: string;
  isUnderline?: boolean;
  displayAsButton?: boolean;
  buttonVariant?: ButtonVariant;
};

const {
  isUnderline,
  icon,
  displayAsButton,
  buttonVariant = "default",
  ...props
} = Astro.props;
---

<a
  href={props.href}
  class:list={[
    props.class,
    {
      ["cursor-pointer transition-all"]: true,
      ["flex justify-center items-center gap-x-2"]: !!icon,
      ["hover:text-neutral-300"]: !displayAsButton,
      ["rounded-full py-2 px-4 text-center font-semibold"]: displayAsButton,
      [buttonVariants[buttonVariant]]: displayAsButton,
      ["underline decoration-2 underline-offset-4"]: isUnderline,
    },
  ]}
  {...props}
  rel="noreferrer"
  target="_blank"
>
  {icon && <Icon name={icon} class="h-6 w-6" />}
  <slot />
  <span class="sr-only"><slot /> link</span>
</a>

<style>
  .btn-glass::after {
    content: "";
    position: absolute;
    left: 2px;
    right: 2px;
    top: 2px;
    height: 48%;
    border-radius: 999px 999px 60% 60% / 999px 999px 100% 100%;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.3),
      rgba(255, 255, 255, 0)
    );
    pointer-events: none;
  }
</style>
